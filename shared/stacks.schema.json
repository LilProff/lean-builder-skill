{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lean-builder decision table",
  "type": "object",
  "required": ["version", "rows"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "context", "commercial", "accounts_owner", "stack", "fallbacks", "why", "overlays", "upgrade_triggers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "type": { "enum": ["website", "saas", "internal", "agent"] },
          "context": { "enum": ["personal", "client", "startup"] },
          "commercial": { "enum": [true, false, "any"] },
          "accounts_owner": { "enum": ["builder", "client"] },
          "stack": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } },
          "fallbacks": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
          "why": { "type": "object", "additionalProperties": { "type": "string", "minLength": 10 } },
          "overlays": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "upgrade_triggers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9-]+:[a-z0-9_]+(>[0-9.]+)?$" }
          }
        }
      }
    }
  }
}
